{
  "_comment": "Single source of truth for SmartGrid topology. Backend and frontend both load this via /api/config.",

  "services": {
    "pingService":     { "port": 3000 },
    "mplsGnmiService": { "port": 3002 }
  },

  "mplsRtus": {
    "_comment": "MPLS RTU nodes running IEC 61850 GOOSE TPT daemon (tpt-daemon.py). IPs from containerlab inspect.",
    "rtu1": { "host": "192.168.30.6", "name": "RTU1", "tptPort": 8850, "accessNode": "mpls-a1-1", "gooseHost": "192.168.100.3", "peerHost": "192.168.100.4" },
    "rtu2": { "host": "192.168.30.7", "name": "RTU2", "tptPort": 8850, "accessNode": "mpls-a1-3", "gooseHost": "192.168.100.4", "peerHost": "192.168.100.3" }
  },

  "mplsNetwork": {
    "_comment": "Nokia SR-OS nodes from smart_grid.yaml. gnmiPort 57400 = SR-OS default. Credentials for srsim image.",
    "credentials": { "username": "admin", "password": "NokiaSros1!" },
    "sampleIntervalNs": 10000000000,
    "insecure": true,
    "gnmicContainer": "gnmic",
    "gnmicBinary": "/app/gnmic",
    "nodes": {
      "mpls-dc1":    { "host": "192.168.30.2",  "name": "dc1",        "type": "SR-1",    "role": "core",        "gnmiPort": 57400,
                       "ports": ["1/1/c1/1","1/1/c2/1"],
                       "links": { "1/1/c1/1": "SR1-ACC1", "1/1/c2/1": "dc2" } },
      "mpls-dc2":    { "host": "192.168.30.3",  "name": "dc2",        "type": "SR-1",    "role": "core",        "gnmiPort": 57400,
                       "ports": ["1/1/c1/1","1/1/c2/1"],
                       "links": { "1/1/c1/1": "SR1-ACC2", "1/1/c2/1": "dc1" } },
      "mpls-acc1":   { "host": "192.168.30.4",  "name": "SR1-ACC1",   "type": "SR-1",    "role": "aggregation", "gnmiPort": 57400,
                       "ports": ["1/1/c1/1","1/1/c2/1","1/1/c3/1"],
                       "links": { "1/1/c1/1": "dc1", "1/1/c2/1": "ACCESS1-1", "1/1/c3/1": "SR1-ACC2" } },
      "mpls-acc2":   { "host": "192.168.30.5",  "name": "SR1-ACC2",   "type": "SR-1",    "role": "aggregation", "gnmiPort": 57400,
                       "ports": ["1/1/c1/1","1/1/c2/1","1/1/c3/1"],
                       "links": { "1/1/c1/1": "dc2", "1/1/c2/1": "ACCESS1-3", "1/1/c3/1": "SR1-ACC1" } },
      "mpls-a1-1":   { "host": "192.168.30.11", "name": "ACCESS1-1",  "type": "SR-1",    "role": "access",      "gnmiPort": 57400,
                       "ports": ["1/1/c1/1","1/1/c2/1","1/1/c3/1"],
                       "links": { "1/1/c2/1": "SR1-ACC1", "1/1/c1/1": "ACCESS1-2", "1/1/c3/1": "RTU1" } },
      "mpls-a1-2":   { "host": "192.168.30.12", "name": "ACCESS1-2",  "type": "SR-1",    "role": "access",      "gnmiPort": 57400,
                       "ports": ["1/1/c1/1","1/1/c2/1"],
                       "links": { "1/1/c1/1": "ACCESS1-1", "1/1/c2/1": "ACCESS1-3" } },
      "mpls-a1-3":   { "host": "192.168.30.13", "name": "ACCESS1-3",  "type": "SR-1",    "role": "access",      "gnmiPort": 57400,
                       "ports": ["1/1/c1/1","1/1/c2/1","1/1/c3/1"],
                       "links": { "1/1/c2/1": "SR1-ACC2", "1/1/c1/1": "ACCESS1-2", "1/1/c3/1": "RTU2" } }
    },
    "infrastructure": {
      "gnmic":      { "host": "192.168.30.10", "name": "gnmic",      "kind": "linux",
                      "image": "ghcr.io/openconfig/gnmic:latest",
                      "role": "collector",  "apiPort": 9804,
                      "config": "/app/gnmic.yaml",
                      "note": "gNMI collector — subscribes to all SR-OS nodes" },
      "gnmi-relay": { "host": "192.168.30.20", "name": "gnmi-relay", "kind": "linux",
                      "image": "alpine/socat",
                      "role": "relay",      "listenPort": 57400,
                      "forwardsTo": "192.168.30.2:57400",
                      "note": "TCP relay: host:57400 → dc1:57400 (allows external gnmic access)" }
    }
  },

  "grid": {
    "cityDemandMW": 2800,
    "transmissionUnits": 4,
    "transmissionLossPerUnitPct": 25
  }
}
